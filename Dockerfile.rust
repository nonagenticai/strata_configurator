# One Dockerfile: --build-arg PACKAGE=configurator-api
ARG BASE_REGISTRY=registry.internal:5000
FROM ${BASE_REGISTRY}/library/rust:1.98-bookworm AS build
ARG PACKAGE
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY seed ./seed
RUN test -n "$PACKAGE" \
 && cargo build --release --locked -p "$PACKAGE" \
 && mkdir /out \
 && find target/release -maxdepth 1 -type f -perm -u+x -exec cp {} /out/ \;

FROM ${BASE_REGISTRY}/library/debian:12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
USER 65532:65532
